function calculateBMI(){

    let h=document.getElementById("height").value/100;
    let w=document.getElementById("weight").value;

    let bmi=(w/(h*h)).toFixed(2);

    let status="";

    if(bmi<18.5)
        status="Underweight";
    else if(bmi<25)
        status="Normal";
    else if(bmi<30)
        status="Overweight";
    else
        status="Obese";

    document.getElementById("result").innerHTML=
    "BMI: "+bmi+"<br>"+status;
}
